# Copy to .env and use your own local settings. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=dependency_aware_mcp

# Replace with the name of a tool-capable model installed in Ollama.
OLLAMA_MODEL=your-installed-model
# Optional: use a different installed model for semantic auditing.
# OLLAMA_AUDITOR_MODEL=your-auditor-model
OLLAMA_BASE_URL=http://127.0.0.1:11434

MCP_URL=http://127.0.0.1:8001/mcp
